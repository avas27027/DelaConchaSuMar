        height="17"
        viewBox="0 0 20 17"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M0 16.7l0-1.95c0.48333 0 0.89583-0.075 1.2375-0.225 0.34167-0.15 0.6875-0.3125 1.0375-0.4875 0.35-0.175 0.7375-0.33333 1.1625-0.475 0.425-0.14167 0.95-0.2125 1.575-0.2125 0.625 0 1.14167 0.07083 1.55 0.2125 0.40833 0.14167 0.7875 0.3 1.1375 0.475 0.35 0.175 0.7 0.3375 1.05 0.4875 0.35 0.15 0.76667 0.225 1.25 0.225 0.48333 0 0.9-0.075 1.25-0.225 0.35-0.15 0.7-0.3125 1.05-0.4875 0.35-0.175 0.73333-0.33333 1.15-0.475 0.41667-0.14167 0.9375-0.2125 1.5625-0.2125 0.625 0 1.14584 0.07083 1.5625 0.2125 0.41667 0.14167 0.8 0.3 1.15 0.475 0.35 0.175 0.7 0.3375 1.05 0.4875 0.35 0.15 0.75833 0.225 1.225 0.225l0 1.95c-0.63333 0-1.1625-0.075-1.5875-0.225-0.425-0.15-0.8125-0.3125-1.1625-0.4875-0.35-0.175-0.69167-0.33333-1.025-0.475-0.33333-0.14167-0.74167-0.2125-1.225-0.2125-0.46667 0-0.87083 0.07083-1.2125 0.2125-0.34167 0.14167-0.68333 0.3-1.025 0.475-0.34167 0.175-0.725 0.3375-1.15 0.4875-0.425 0.15-0.9625 0.225-1.6125 0.225-0.65 0-1.1875-0.075-1.6125-0.225-0.425-0.15-0.80833-0.3125-1.15-0.4875-0.34167-0.175-0.67917-0.33333-1.0125-0.475-0.33333-0.14167-0.7375-0.2125-1.2125-0.2125-0.475 0-0.88333 0.07083-1.225 0.2125-0.34167 0.14167-0.6875 0.3-1.0375 0.475-0.35 0.175-0.7375 0.3375-1.1625 0.4875-0.425 0.15-0.95417 0.225-1.5875 0.225l0 0m0-4.45l0-1.95c0.48333 0 0.89583-0.075 1.2375-0.225 0.34167-0.15 0.6875-0.3125 1.0375-0.4875 0.35-0.175 0.7375-0.33333 1.1625-0.475 0.425-0.14167 0.95-0.2125 1.575-0.2125 0.625 0 1.14167 0.07083 1.55 0.2125 0.40833 0.14167 0.7875 0.3 1.1375 0.475 0.35 0.175 0.7 0.3375 1.05 0.4875 0.35 0.15 0.76667 0.225 1.25 0.225 0.48333 0 0.9-0.075 1.25-0.225 0.35-0.15 0.7-0.3125 1.05-0.4875 0.35-0.175 0.73333-0.33333 1.15-0.475 0.41667-0.14167 0.93333-0.2125 1.55-0.2125 0.63333 0 1.15834 0.07083 1.575 0.2125 0.41667 0.14167 0.8 0.3 1.15 0.475 0.35 0.175 0.7 0.3375 1.05 0.4875 0.35 0.15 0.75833 0.225 1.225 0.225l0 1.95c-0.63333 0-1.1625-0.075-1.5875-0.225-0.425-0.15-0.8125-0.3125-1.1625-0.4875-0.35-0.175-0.69167-0.33333-1.025-0.475-0.33333-0.14167-0.